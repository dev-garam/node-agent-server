# Gemini (Google) API key
GOOGLE_API_KEY="your_gemini_api_key"

# Optional alias (if any code expects GEMINI_API_KEY)
GEMINI_API_KEY="your_gemini_api_key"

# Use Gemini model by default
INTENT_DETECT_DEFAULT_MODEL="google-genai:gemini-2.5-flash-lite"
INTENT_DETECT_ALLOW_FALLBACK=false

# Local Swagger click-test (disable HMAC only in local/dev)
AGENT_HMAC_ENABLED=false

# CORS (server-to-server only면 false 권장)
CORS_ENABLED=false
# CORS_ORIGIN="https://admin.example.com,https://stg-admin.example.com"

# Local server
PORT=8889
HOST="0.0.0.0"
